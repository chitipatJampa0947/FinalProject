# Ignore Node.js dependencies
ai-detection-app/node_modules/
ai-detection-app/dist/

# Ignore local environment files
ai-detection-app/.env

# Ignore OS generated files
.DS_Store
Thumbs.db

# Ignore Claude's local config file
settings.local.json

#ignore .env files in the root directory
.env

# (เพิ่มเติม) ถ้ามีไฟล์ชั่วคราวของ MS Word/Excel
~$*.docx
~$*.xlsx

# Document folder — Thai long filenames break Linux filesystem (>255 bytes)
Document and Draft/

# Large ML model files (>100MB, not suitable for GitHub without Git LFS)
scripts/wangchanberta-ai-detector/
scripts/onnx_model/
scripts/onnx_model_int8/
ai-detection-app/public/model/
*.safetensors
*.onnx
optimizer.pt
scheduler.pt
scaler.pt
rng_state.pth
training_args.bin