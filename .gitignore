# Training pipeline outputs (regenerable from scripts/)
# data/             : combine_dataset.py output (train.csv / val.csv / test.csv)
# model_output/     : train_model.py output (final model + tokenizer + checkpoint-*)
# logs/             : training stdout/stderr + HF Trainer logs
# web_model_ready/  : staging dir for R2 upload (model_quantized.onnx + tokenizer files)
data/
model_output/
logs/
web_model_ready/

# Large dataset artifacts (>50MB, regenerable from scrapers / generate_ai.py)
# ai_generated_dataset.csv  : 137 MB, generate_ai.py output (Gemini + GPT-4o-mini)
# thestandard_dataset.csv   : 58 MB,  thestandard_scraper.py output
# cleaned_human_dataset.csv : 57 MB,  cleaned human-text intermediate
scripts/ai_generated_dataset.csv
scripts/thestandard_dataset.csv
scripts/cleaned_human_dataset.csv